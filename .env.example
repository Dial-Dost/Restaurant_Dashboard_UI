# ──────────────────────────────────────────────────────────────────────────
# Restaurant Dashboard UI (Next.js) — environment example
#
# IMPORTANT: every NEXT_PUBLIC_* var is BAKED IN AT BUILD TIME.
# Next.js inlines these values into the client bundle during `npm run build`,
# so changing them at runtime has NO effect — you must rebuild.
#
# On Railway / Docker these are passed as Docker build ARGs (see Dockerfile:
#   ARG NEXT_PUBLIC_BACKEND_URL / ARG NEXT_PUBLIC_FEEDBACK_FORM_URL) and the
# CI workflow (.github/workflows/dashboard-ci.yml) sets them at build.
# For local dev, copy this file to `.env.local`.
# ──────────────────────────────────────────────────────────────────────────

# Base URL of the Restaurant_Backend API (Express, default port 3001).
# Used by src/lib/db.ts, src/lib/socket.ts (socket.io), src/lib/platform.ts,
# src/services/authService.ts, and several dashboard pages.
# Production example: https://your-backend.up.railway.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# OPTIONAL override for the customer feedback form URL. The form now lives
# INSIDE this app at /feedback, and the settings/print QR flows default to
# same-origin "<origin>/feedback" — so normally leave this unset. Only set it to
# point at a separately hosted form (e.g. the deprecated Restaurant_Feedback_UI).
# NEXT_PUBLIC_FEEDBACK_FORM_URL=https://your-feedback-app.up.railway.app

# ──────────────────────────────────────────────────────────────────────────
# Legacy / optional fallbacks (only set if you have a reason to)
# ──────────────────────────────────────────────────────────────────────────
# DEPRECATED alias for NEXT_PUBLIC_BACKEND_URL. The code (src/lib/db.ts) still
# reads it as a fallback for backwards compatibility, but prefer
# NEXT_PUBLIC_BACKEND_URL above. Do NOT rely on this for new deployments.
# NEXT_PUBLIC_RECEPTION_API_URL=http://localhost:3001

# Optional override for the reception/voice server base URL. If unset, the code
# falls back to NEXT_PUBLIC_BACKEND_URL. Only set if reception runs separately.
# NEXT_PUBLIC_RECEPTION_SERVER_URL=http://localhost:3001
